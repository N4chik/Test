# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Ваш числовой Telegram ID (узнать: @userinfobot). Доступ к боту будет только у него.
ADMIN_ID=123456789

# Ключ API с https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Модель OpenRouter (можно gpt-4o-mini, anthropic/claude-3.5-haiku и т.д.)
OPENROUTER_MODEL=google/gemini-flash-1.5-8b

# Прокси для обхода блокировок Telegram в РФ. Форматы:
#   socks5://login:pass@host:1080
#   socks5h://host:1080
#   http://login:pass@host:8080
# Оставьте пустым, чтобы работать напрямую.
PROXY_URL=socks5://login:password@your-server-ip:1080

# Часовой пояс для напоминаний
TZ=Europe/Moscow
